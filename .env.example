# Copy this file to .env and fill real secrets.
# Never commit .env.

COMPOSE_PROJECT_NAME=trading-assistant
TZ=UTC

# ---------------------------------------------------------------------------
# Neo4j
# ---------------------------------------------------------------------------
# Format: user/password
NEO4J_AUTH=neo4j/change_me_strong_password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_strong_password

# ---------------------------------------------------------------------------
# PostgreSQL / Windmill
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=windmill
# Must match POSTGRES_PASSWORD and POSTGRES_DB above.
DATABASE_URL=postgres://postgres:change_me_postgres_password@db:5432/windmill?sslmode=disable
WM_IMAGE=ghcr.io/windmill-labs/windmill:main

# Windmill logging
LOG_MAX_SIZE=20m
LOG_MAX_FILE=10

# Path mounted into Windmill workers as /data/portfolio
# Keep ./portfolio-data if you want to use the sample data in this repo.
PORTFOLIO_DATA_PATH=./portfolio-data

# ---------------------------------------------------------------------------
# Steel Browser
# ---------------------------------------------------------------------------
DOMAIN=localhost:3000
CDP_DOMAIN=localhost:9223
API_URL=http://steel_api:3000

# ---------------------------------------------------------------------------
# Caddy / public URL
# ---------------------------------------------------------------------------
BASE_URL=:80
# Optional: set only if you need to restrict bind address.
# ADDRESS=

# ---------------------------------------------------------------------------
# Telegram alerts
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Local LLM / Ollama
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Hugging Face / other API keys
# ---------------------------------------------------------------------------
HUGGINGFACE_API_TOKEN=